<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The Connect IQ SDK reaches the watch through Garmin Connect Mobile,
         which must be installed. On Android 11+ package visibility is
         filtered, so it has to be declared explicitly or the SDK cannot
         find it. -->
    <!-- Android will happily kill this process mid-route otherwise. The
         foreground notification is the price of staying alive while relaying;
         "connectedDevice" is the accurate type, since that is literally what
         this does. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- "connectedDevice" looked like the honest type, but Android 14 also
         demands one of BLUETOOTH_*/CHANGE_NETWORK_STATE/NFC/USB alongside it,
         and this app holds none of them: the Bluetooth link belongs to Garmin
         Connect, not to us. "specialUse" states the case instead of claiming a
         permission we have no business holding. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Package visibility is filtered on Android 11+. OsmAnd has to be
         listed or getPackageInfo() reports it missing even when it is plainly
         installed, and the AIDL bind then never happens. All three build
         flavours, since any of them can be the one present. -->
    <queries>
        <package android:name="com.garmin.android.apps.connectmobile" />
        <package android:name="net.osmand" />
        <package android:name="net.osmand.plus" />
        <package android:name="net.osmand.dev" />
    </queries>

    <application
        android:label="Maps Relay"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Maps Relay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Still a notification listener, but only for the street name and
             ETA now: the maneuver and the distance come from OsmAnd's AIDL
             service instead. Reading another app's notifications requires this
             permission and an explicit grant by the user in system settings;
             it cannot be requested from inside the app. -->
        <service
            android:name=".NavListener"
            android:exported="true"
            android:label="Maps Relay"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Relays OsmAnd navigation guidance to a paired Garmin watch for the duration of a route." />
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
